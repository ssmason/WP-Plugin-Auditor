{
  "name": "ssmason/wp-plugin-auditor",
  "description": "Audits WordPress plugins for security issues and coding standards violations.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3",
    "wp-coding-standards/wpcs": "^3",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpstan/phpstan": "^1",
    "szepeviktor/phpstan-wordpress": "^1",
    "phpunit/phpunit": "^9",
    "brain/monkey": "^2",
    "mockery/mockery": "^1"
  },
  "autoload": {
    "classmap": [ "includes/" ]
  },
  "autoload-dev": {
    "classmap": [ "tests/" ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/ssmason/WP-Plugin-Auditor"
    }
  ],
  "scripts": {
    "analyze": "phpstan analyse --configuration phpstan.neon.dist"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
