{
  "permissions": {
    "allow": [
      "Bash(composer *)",
      "Bash(wp *)",
      "Bash(npm run *)",
      "Bash(phpcs *)",
      "Bash(git *)",
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Edit(CLAUDE.md)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/phpcs-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/eslint-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pint-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"Session ended.\"}'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before responding: do only what was asked. No extra tool calls. No explanations unless asked. No restating the user's message. One question if uncertain."
          }
        ]
      }
    ]
  },
  "env": {},
  "model": "",
  "outputStyle": ""
}